# ==============================================================================
# MARKETMIND AI — CONFIGURATION TEMPLATE
# Copy this file to .env and configure your environment variables.
# Never commit your actual .env file with secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="MarketMind AI"
API_PREFIX=/api

# Database Connection
# SQLite fallback (default for local development):
DATABASE_URL=sqlite:///./marketmind.db
# PostgreSQL / Supabase connection example:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Market Data Providers (Optional - Demo mode works without any keys)
DEFAULT_PROVIDER=demo
DEMO_MODE_DEFAULT=true

# Twelve Data API Key (https://twelvedata.com/)
TWELVE_DATA_API_KEY=

# Alpha Vantage API Key (https://www.alphavantage.co/)
ALPHA_VANTAGE_API_KEY=

# Finnhub Stock API Key (https://finnhub.io/)
FINNHUB_API_KEY=

# Google Gemini API Key (for grounded LLM conversational assistant)
GEMINI_API_KEY=

# Frontend Configuration (for frontend/.env)
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
